# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Virtual environments
venv/
.venv/
env/

# Database cache (automatically rebuilt if missing)
database/*.pkl
!database/.gitkeep

# Generated outputs
output/*.jpg
output/*.png
output/*.mp4
!output/.gitkeep

# OS generated files
.DS_Store
Thumbs.db
